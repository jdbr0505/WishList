# PLANTILLA de secretos para la version privada (Google Sheets + login de Google).
#
# Como usarla:
#  * En tu computadora: copia este archivo como  .streamlit/secrets.toml  y completa los valores.
#    Ese archivo esta en .gitignore: NUNCA se sube a git. No pegues valores reales en ESTE archivo.
#  * En Streamlit Community Cloud: pega el contenido en  Settings > Secrets  de la app privada.
#
# Todos los valores de abajo son de ejemplo. Guia completa: docs/NUBE_PRIVADA.md

# Activa la version privada. En la nube va aqui. En tu computadora NO lo pongas en el archivo:
# usa la variable de entorno solo cuando quieras probarla  ($env:WISHLIST_MODO = "nube"),
# o tu app local pasaria a usar Google Sheets en vez de tu Excel.
WISHLIST_MODO = "nube"

# Unicos correos de Google que pueden entrar (ademas de iniciar sesion). Si esta vacio, no entra nadie.
correos_permitidos = ["tu-correo@gmail.com"]

# --- Login con Google (OIDC) ---
[auth]
redirect_uri = "https://TU-APP-PRIVADA.streamlit.app/oauth2callback"   # en tu PC: http://localhost:8501/oauth2callback
cookie_secret = "GENERA-UNA-CADENA-LARGA-Y-ALEATORIA"                  # python -c "import secrets; print(secrets.token_urlsafe(32))"
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "xxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# --- Hoja de Google donde viven tus datos ---
[gsheets]
spreadsheet_id = "ID-DE-TU-HOJA"        # lo que va entre /d/ y /edit en la direccion de la hoja

# --- Cuenta de servicio (el contenido del archivo JSON que descargas de Google Cloud) ---
[gcp_service_account]
type = "service_account"
project_id = "tu-proyecto"
private_key_id = "xxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nxxxxxxxx\n-----END PRIVATE KEY-----\n"
client_email = "tu-cuenta@tu-proyecto.iam.gserviceaccount.com"
client_id = "xxxxxxxx"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/tu-cuenta%40tu-proyecto.iam.gserviceaccount.com"
